+def _delta_norm(w, w_ori, keys):
+    return sum((w[k].float() - w_ori[k].float()).pow(2).sum().item() for k in keys) ** 0.5
+
+
+def flame_clip(w_locals, ori_weight, keys, logger, epoch):
+    """Simplified FLAME: clip each client delta to the median delta norm.
+    Omits noise and HDBSCAN clustering; captures the norm-clip defence property."""
+    norms = [_delta_norm(w, ori_weight, keys) for w in w_locals]
+    med = float(np.median(norms))
+    clipped = []
+    for w, n in zip(w_locals, norms):
+        if n > med and n > 0:
+            scale = med / n
+            w_c = {k: (ori_weight[k] + (w[k] - ori_weight[k]) * scale).to(w[k].dtype)
+                   if k in keys else w[k]
+                   for k in w}
+            clipped.append(w_c)
+        else:
+            clipped.append(w)
+    logger.info(f'FLAME ep={epoch} median_norm={med:.4f} '
+                f'norms=[{",".join(f"{n:.2f}" for n in norms)}]')
+    return clipped
+
+
+def flame_full_aggregate(w_ori, w_locals, agent_keys, adv_keys, params, epoch, logger, rng):
+    """Full faithful FLAME (USENIX Security 2022, Nguyen et al.).
+    All three components:
+      1. HDBSCAN cosine clustering — majority cluster only (min_cs = n//2+1).
+      2. Median L2 norm clip on kept deltas.
+      3. Gaussian noise N(0, (lambda*S_t)^2) per coordinate.
+    Uses sklearn.cluster.HDBSCAN (NumPy 2.x compatible).
+    lambda is read from params['flame_lambda'] (default 0.001, paper's setting).
+    Logs [FLAME_FULL] per round: labels, kept/excluded clients, adv status, S_t, sigma.
+    """
+    import warnings as _warnings
+    _warnings.filterwarnings('ignore')
+    from sklearn.cluster import HDBSCAN as _HDBSCAN
+
+    _BUF = ('running_mean', 'running_var', 'num_batches_tracked')
+    def _is_param(k):
+        return not any(k.endswith(s) for s in _BUF)
+
+    param_keys = [k for k in w_ori if _is_param(k)]
+
+    def _flat(w):
+        return np.concatenate([w[k].float().cpu().numpy().flatten() for k in param_keys])
+
+    n = len(w_locals)
+    g_flat = _flat(w_ori)
+    deltas = np.stack([_flat(w) - g_flat for w in w_locals])
+
+    # Component 1: HDBSCAN cosine clustering
+    norms = np.linalg.norm(deltas, axis=1, keepdims=True) + 1e-9
+    normed = deltas / norms
+    cos_dist = np.clip(1.0 - normed @ normed.T, 0.0, 2.0).astype(np.float64)
+    min_cs = max(2, n // 2 + 1)
+    try:
+        labels = _HDBSCAN(min_cluster_size=min_cs, metric='precomputed',
+                          allow_single_cluster=True).fit_predict(cos_dist)
+    except Exception as e:
+        logger.info(f'FLAME_FULL ep={epoch} HDBSCAN error keep_all: {e}')
+        labels = np.zeros(n, dtype=int)
+
+    if labels.max() >= 0:
+        unique, counts = np.unique(labels[labels >= 0], return_counts=True)
+        largest = unique[counts.argmax()]
+        keep = labels == largest
+    else:
+        keep = np.ones(n, dtype=bool)
+
+    kept_ids = [agent_keys[i] for i in range(n) if keep[i]]
+    excl_ids = [agent_keys[i] for i in range(n) if not keep[i]]
+    adv_set  = set(adv_keys)
+    logger.info('[FLAME_FULL] ep={} labels={} kept={} excl={} adv_kept={} adv_excl={}'.format(
+        epoch, labels.tolist(), kept_ids, excl_ids,
+        [c for c in kept_ids if c in adv_set],
+        [c for c in excl_ids if c in adv_set]))
+
+    # Component 2: Median norm clip
+    kept_deltas = deltas[keep]
+    kept_norms  = np.linalg.norm(kept_deltas, axis=1)
+    S_t = float(np.median(kept_norms))
+    clipped = np.stack([
+        d / max(1.0, float(np.linalg.norm(d)) / (S_t + 1e-9))
+        for d in kept_deltas
+    ])
+
+    # Component 3: Average + Gaussian noise
+    agg = clipped.mean(axis=0)
+    lam = float(params.get('flame_lambda', 0.001))
+    sigma = lam * S_t
+    if sigma > 0:
+        agg = agg + rng.normal(0.0, sigma, agg.shape).astype(np.float32)
+
+    logger.info('[FLAME_FULL] ep={} S_t={:.4f} sigma={:.6f} n_kept={}/{} lam={}'.format(
+        epoch, S_t, sigma, int(keep.sum()), n, lam))
+
+    # Reconstruct state dict
+    w_out = {}
+    offset = 0
+    kept_ws = [w_locals[i] for i in range(n) if keep[i]]
+    for k in w_ori:
+        if _is_param(k):
+            numel = w_ori[k].numel()
+            chunk = torch.from_numpy(
+                agg[offset:offset + numel].reshape(w_ori[k].shape).copy())
+            w_out[k] = (w_ori[k].float().cpu() + chunk).to(w_ori[k].dtype)
+            offset += numel
+        else:
+            w_out[k] = torch.stack(
+                [w[k].float().cpu() for w in kept_ws]).mean(0).to(w_ori[k].dtype)
+    return w_out
+
+
+def _load_root_data(root_path, device):
+    """Load server root dataset from a pickle file containing (x_np, y_np)."""
+    with open(root_path, 'rb') as f:
+        x_np, y_np = pickle.load(f)
+    x = torch.tensor(x_np, dtype=torch.float32, device=device)
+    y = torch.tensor(y_np, dtype=torch.long, device=device)
+    return x, y
+
+
+def fltrust_aggregate(w_ori, w_locals, root_x, root_y, params, epoch, dev, logger):
+    """FLTrust aggregation.
+    Server trains one local epoch on root data, then weights each client update
+    by relu(cosine_similarity(client_delta, server_delta)), normalising client
+    deltas to the server delta norm before summing."""
+    from models.ResNet8 import ResNet8
+    keys = [k for k in w_ori.keys() if w_ori[k].dtype != torch.int64]
+
+    # Server reference update on root data.
+    srv_model = ResNet8(num_classes=10).to(dev)
+    srv_model.load_state_dict({k: v.clone() for k, v in w_ori.items()})
+    srv_model.train()
+    optimizer = torch.optim.SGD(srv_model.parameters(),
+                                lr=params['lr'], momentum=params.get('momentum', 0.9))
+    criterion = torch.nn.CrossEntropyLoss()
+    for _ in range(params.get('fltrust_server_epochs', 2)):
+        optimizer.zero_grad()
+        loss = criterion(srv_model(root_x), root_y)
+        loss.backward()
+        optimizer.step()
+
+    w_srv = srv_model.state_dict()
+    srv_delta_flat = torch.cat(
+        [(w_srv[k].float() - w_ori[k].float()).flatten() for k in keys])
+    srv_norm = srv_delta_flat.norm().item()
+
+    if srv_norm < 1e-8:
+        logger.info(f'FLTrust ep={epoch}: server delta ~0, falling back to FedAvg')
+        w_out = {k: v.clone() for k, v in w_ori.items()}
+        for k in keys:
+            w_out[k] = w_ori[k] + torch.stack(
+                [(w[k].float() - w_ori[k].float()) for w in w_locals]).mean(0).to(w_ori[k].dtype)
+        return w_out
+
+    trust_scores = []
+    for w in w_locals:
+        cli_delta_flat = torch.cat(
+            [(w[k].float() - w_ori[k].float()).flatten() for k in keys])
+        cos = F.cosine_similarity(
+            cli_delta_flat.unsqueeze(0), srv_delta_flat.unsqueeze(0)).item()
+        trust_scores.append(max(0.0, cos))
+
+    ts_sum = sum(trust_scores)
+    logger.info(f'FLTrust ep={epoch} srv_norm={srv_norm:.4f} '
+                f'trust=[{",".join(f"{t:.3f}" for t in trust_scores)}] sum={ts_sum:.4f}')
+
+    w_out = {k: v.clone() for k, v in w_ori.items()}
+    if ts_sum < 1e-8:
+        return w_out  # all clients distrusted — keep global model
+
+    for k in keys:
+        agg = torch.zeros_like(w_ori[k].float())
+        for w, ts in zip(w_locals, trust_scores):
+            if ts <= 0:
+                continue
+            cli_delta = (w[k].float() - w_ori[k].float())
+            cli_norm = _delta_norm(w, w_ori, keys)
+            # normalise client delta to server norm then weight by trust score
+            scale = (srv_norm / cli_norm) if cli_norm > 1e-8 else 0.0
+            agg += ts * cli_delta * scale
+        w_out[k] = (w_ori[k].float() + params['eta'] * agg / ts_sum).to(w_ori[k].dtype)
+    return w_out
+
