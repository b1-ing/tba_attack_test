+def pixel_space_defense(d1, d2, params, the_epoch):
+    """Pixel-space replacement for gan_defense: same Stage 1/2 loss, no GAN generator.
+
+    Stage 1: optimise image_num images per class directly in raw [0,1] pixel space,
+             then ImageNet-normalise before discriminator forward passes.
+    Stage 2: optimise a 1-channel trigger delta (unconstrained, broadcast to 3ch)
+             in the same normalised domain; same loss terms as gan_defense Stage 2.
+    Returns: list of (image_num, 3, 32, 32) probe tensors in ImageNet-normalised space.
+    No architectural frequency bias — probes can contain any spatial frequency.
+    """
+    lr_s1   = 0.02
+    lr_s2   = 0.01
+    classnum = 10
+    dims    = 3
+    image_num = 32
+    Alpha   = 0.75
+    n_epochs1 = params.get('pixel_probe_epochs1', 50)
+    n_epochs2 = params.get('pixel_probe_epochs2', 25)
+
+    MEAN_T = torch.tensor([0.485, 0.456, 0.406], device=device).view(1, 3, 1, 1)
+    STD_T  = torch.tensor([0.229, 0.224, 0.225], device=device).view(1, 3, 1, 1)
+
+    def normalize(x):
+        return (x - MEAN_T) / STD_T
+
+    discriminator1 = ResNet8(num_classes=classnum).to(device)
+    discriminator2 = ResNet8(num_classes=classnum).to(device)
+    discriminator1.load_state_dict(d1)
+    discriminator2.load_state_dict(d2)
+    discriminator1.eval()
+    discriminator2.eval()
+
+    # Stage 1: per-class image optimisation in raw [0,1]
+    ori_imgs = []
+    for c in range(classnum):
+        x = torch.rand(image_num, dims, 32, 32, device=device).clamp(0.0, 1.0)
+        x.requires_grad_(True)
+        opt = torch.optim.Adam([x], lr=lr_s1)
+        best_loss, best_xn = float('inf'), None
+        for _ in range(n_epochs1):
+            opt.zero_grad()
+            xn = normalize(x.clamp(0.0, 1.0))
+            out1 = torch.softmax(discriminator1(xn), dim=1).std(dim=1).mean()
+            out2 = torch.softmax(discriminator2(xn), dim=1)[:, c].mean()
+            loss = Alpha * out1 + (1.0 - Alpha) * (1.0 - out2)
+            loss.backward()
+            opt.step()
+            with torch.no_grad():
+                x.clamp_(0.0, 1.0)
+            if loss.item() < best_loss:
+                best_loss = loss.item()
+                best_xn = normalize(x.detach().clamp(0.0, 1.0))
+        ori_imgs.append(best_xn if best_xn is not None
+                        else normalize(x.detach().clamp(0.0, 1.0)))
+
+    # Stage 2: trigger optimisation in normalised input space
+    tri_imgs = []
+    if n_epochs2 > 0:
+        other_imgs = torch.cat(ori_imgs[1:]).detach()   # classes 1-9, normalised
+        this_imgs  = ori_imgs[0].detach()               # class 0, normalised
+
+        # 1-channel unconstrained delta, broadcast to 3ch (mirrors GAN's 1-ch trigger)
+        t = torch.zeros(image_num, 1, 32, 32, device=device, requires_grad=True)
+        opt_t = torch.optim.Adam([t], lr=lr_s2)
+        best_loss_t, best_probe = float('inf'), None
+
+        for ep in range(n_epochs2):
+            opt_t.zero_grad()
+            trigger_3ch = t.repeat(1, dims, 1, 1)   # (N, 3, 32, 32)
+
+            # Term A: non-target + trigger → class-0 / uncertain on old model
+            tiled = trigger_3ch.repeat(classnum - 1, 1, 1, 1)[:other_imgs.size(0)]
+            comp_a = other_imgs + tiled
+            oa1 = torch.softmax(discriminator1(comp_a), dim=1).std(dim=1).mean()
+            oa2 = torch.softmax(discriminator2(comp_a), dim=1).mean(0)[0]
+            g_loss = 0.75 * oa1 + 0.25 * (1.0 - oa2)
+
+            # Term B: target - trigger → uncertain / class-0; trigger alone → class-0
+            comp_b = this_imgs - trigger_3ch
+            ob1 = torch.softmax(discriminator1(comp_b), dim=1).std(dim=1).mean()
+            ob2 = torch.softmax(discriminator2(comp_b), dim=1).mean(0)[0]
+            ob3 = torch.softmax(discriminator1(trigger_3ch), dim=1).mean(0)[0]
+            g_loss = g_loss + 0.75 * ob1 + 0.25 * ob2 + 0.25 * ob3
+
+            g_loss.backward()
+            opt_t.step()
+
+            if g_loss.item() < best_loss_t:
+                best_loss_t = g_loss.item()
+                best_probe  = trigger_3ch.detach().clone()
+
+        probe = best_probe if best_probe is not None else trigger_3ch.detach()
+        tri_imgs.append(probe)
+
+    # Optionally save probe batch and model states at specified rounds for spectrum analysis.
+    save_epochs = params.get('probe_save_epochs', [])
+    if the_epoch in save_epochs:
+        import os
+        save_dir = params.get('probe_save_dir', '.')
+        os.makedirs(save_dir, exist_ok=True)
+        probes = (tri_imgs if tri_imgs else ori_imgs)[0]
+        torch.save(probes.cpu(),
+                   os.path.join(save_dir, f'pixel_probe_ep{the_epoch:04d}.pt'))
+        torch.save({'d1': d1, 'd2': d2},
+                   os.path.join(save_dir, f'model_ep{the_epoch:04d}.pt'))
+        logger.info('PROBE_SAVED ep={} shape={} dir={}'.format(
+            the_epoch, list(probes.shape), save_dir))
+
+    return tri_imgs if tri_imgs else ori_imgs
